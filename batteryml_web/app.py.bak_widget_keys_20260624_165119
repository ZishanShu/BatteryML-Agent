    t_api_key = tcols[1].text_input("Troubleshoot LLM API key", value=st.session_state.get("llm_api_key", ""), type="password", key="ts_llm_api_key")
    t_model = tcols[2].text_input("Troubleshoot LLM model", value=st.session_state.get("llm_model", ""), key="ts_llm_model")

    if st.button("Use LLM to explain error"):
        client = LLMClient(base_url=t_base_url or None, api_key=t_api_key or None, model=t_model or None)
        if not client.is_configured():
            st.warning("LLM is not configured.")
        else:
            diagnosis = diagnose_failure(failed_log, config_path=selected_failed_run / "generated_config.yaml", schema_mapping_path=selected_failed_run / "schema_mapping.json", llm_client=client)
            diag_path = selected_failed_run / "error_diagnosis.json"
            fix_path = selected_failed_run / "agent_fix_suggestion.md"
            diag_path.write_text(json.dumps(diagnosis, indent=2, ensure_ascii=False), encoding="utf-8")
            fix_path.write_text(
                f"# Fix suggestion\n\nCategory: {diagnosis.get('failure_category')}\n\nCause: {diagnosis.get('likely_cause')}\n\nSuggested fix: {diagnosis.get('suggested_fix')}\n\nValidator: {diagnosis.get('validator_to_rerun')}\n",
                encoding="utf-8",
            )
            st.session_state["latest_diagnosis"] = diagnosis
            st.json(diagnosis)

    diagnosis = st.session_state.get("latest_diagnosis")
    if diagnosis:
        st.info("No automatic fix will be applied. Confirm before validation.")
        st.write(diagnosis.get("suggested_fix"))
        confirm_fix = st.checkbox("I confirm the suggested fix has been applied manually")
        if st.button("Validate after fix") and confirm_fix:
            validation = run_validator_after_fix(diagnosis.get("failure_category", "Other"), current_root / "generated_config.yaml", current_root / "schema_mapping.json")
